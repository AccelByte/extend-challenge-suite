# Challenge Service - Local Development Environment
# Copy this file to .env: cp .env.example .env

# ============================================================================
# Database Configuration (defaults work with docker-compose out of the box)
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=challenge_db
DB_USER=postgres
DB_PASSWORD=postgres

# Connection Pool Settings
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=300
DB_CONN_MAX_IDLE_TIME=300

# ============================================================================
# Redis Configuration (defaults work with docker-compose out of the box)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================================
# Backend Service Configuration
# ============================================================================
# REWARD_CLIENT_MODE: Controls reward granting implementation
#   - "mock": Use MockRewardClient (for local dev and load testing, no AGS calls)
#   - "real": Use AGSRewardClient (requires valid AGS credentials below)
REWARD_CLIENT_MODE=mock

# PLUGIN_GRPC_SERVER_AUTH_ENABLED: Controls JWT validation
#   - "false": Skip JWT validation (for local dev and load testing)
#   - "true": Validate JWT tokens (requires valid AGS IAM)
PLUGIN_GRPC_SERVER_AUTH_ENABLED=false

# CHALLENGE_CONFIG_PATH: Path to challenges.json in backend service container
CHALLENGE_CONFIG_PATH=/app/config/challenges.json

# BASE_PATH: Base path for HTTP routes
BASE_PATH=/challenge

# ============================================================================
# Event Handler Configuration
# ============================================================================
# CONFIG_PATH: Path to challenges.json in event handler container
CONFIG_PATH=/app/config/challenges.json

# ============================================================================
# AGS Service Account Credentials
# ============================================================================
# Only used when REWARD_CLIENT_MODE=real
# Leave as placeholders for local development with mock mode
# AB_NAMESPACE is always required (used for config validation)
AB_CLIENT_ID=your-client-id
AB_CLIENT_SECRET=your-client-secret
AB_BASE_URL=https://demo.accelbyte.io
AB_NAMESPACE=test

# ============================================================================
# Expired Row Cleanup (M6)
# ============================================================================
# CLEANUP_ENABLED: Enable/disable background cleanup of expired rotating goals
#   - "true": Run cleanup goroutine (default)
#   - "false": Disable cleanup
CLEANUP_ENABLED=true

# CLEANUP_INTERVAL_MINUTES: How often the cleanup runs (default: 60)
CLEANUP_INTERVAL_MINUTES=60

# CLEANUP_RETENTION_DAYS: Keep expired rows for N days before deleting (default: 7)
CLEANUP_RETENTION_DAYS=7

# CLEANUP_BATCH_SIZE: Max rows per DELETE batch (default: 1000)
CLEANUP_BATCH_SIZE=1000

# CLEANUP_MAX_BATCHES_PER_CYCLE: Max batches per cleanup cycle (default: 100)
CLEANUP_MAX_BATCHES_PER_CYCLE=100

# CLEANUP_BATCH_PAUSE_MS: Pause between batches in milliseconds (default: 50, min: 10, max: 5000)
CLEANUP_BATCH_PAUSE_MS=50

# CLEANUP_INITIAL_MAX_BATCHES: Max batches per cycle during initial turbo mode (default: 1000)
CLEANUP_INITIAL_MAX_BATCHES=1000

# CLEANUP_INITIAL_CYCLES: Number of initial cycles to use turbo mode (default: 3)
CLEANUP_INITIAL_CYCLES=3

# CLEANUP_RETRY_BACKOFF_SECONDS: Backoff between retry attempts on DB errors (default: 5, min: 1, max: 60)
CLEANUP_RETRY_BACKOFF_SECONDS=5
